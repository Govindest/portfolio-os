# PortfolioOS optional development configuration.
#
# PortfolioOS stores NO secrets in environment files. Brokerage credentials are
# entered in the app and kept in the operating-system credential store.
# These variables only tune local development behavior.

# Vite dev server port (must match tauri.conf.json build.devUrl if changed).
# VITE_PORT=1420

# Enable extra Rust log output during development.
# RUST_LOG=portfolio_os_lib=debug
