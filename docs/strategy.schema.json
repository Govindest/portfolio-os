{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-os.dev/strategy.schema.json",
  "title": "PortfolioOS strategy",
  "description": "Declarative investment strategy for PortfolioOS. Data only — never executed.",
  "type": "object",
  "required": ["schema_version", "name", "assets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": ["string", "null"], "maxLength": 500 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "target_weight"],
        "additionalProperties": false,
        "properties": {
          "symbol": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.]{0,9}$" },
          "target_weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "rebalance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "const": "target_weight" },
        "drift_threshold_percent": { "type": "number", "minimum": 0, "maximum": 50 },
        "minimum_order_value": { "type": "number", "minimum": 0 },
        "allow_fractional_shares": { "type": "boolean" }
      }
    },
    "risk_controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_position_weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "maximum_order_value": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_batch_value": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
